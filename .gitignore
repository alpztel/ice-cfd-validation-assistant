# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
wheels/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing, static analysis & coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyrefly/
.coverage
coverage.xml
htmlcov/

# Jupyter & IDE scratch files
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Environment secrets (never commit credentials)
.env
.env.*

# Proprietary / heavy 3D CFD solver binaries & restart files (NDA Hygiene Guard)
*.ftsim
*.ftres
*.cas
*.cas.h5
*.dat
*.dat.h5
*.cgns
*.ensight
*.vtk
*.vtu

# Explicitly keep publication figures in assets/ tracked
!assets/*.png
